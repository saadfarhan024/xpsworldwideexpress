generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum UserRole {
  MERCHANT
  OPERATIONS
  SUPPORT
  FINANCE
  ADMIN
}

enum AccountStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ShipmentStatus {
  CREATED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_ATTEMPTED
  ON_HOLD
  RETURNED
  CANCELLED
}

enum PickupStatus {
  REQUESTED
  SCHEDULED
  ASSIGNED
  COMPLETED
  CANCELLED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum RemittanceStatus {
  PENDING
  RECONCILED
  PAID
  ON_HOLD
  CANCELLED
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique @db.Citext
  passwordHash      String
  role              UserRole      @default(MERCHANT)
  status            AccountStatus @default(PENDING_EMAIL_VERIFICATION)
  emailVerifiedAt   DateTime?
  mfaEnabledAt      DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  merchantProfile   MerchantProfile?
  sessions          Session[]
  passwordResets    PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  auditEvents       AuditLog[]   @relation("AuditActor")
  trackingEvents    TrackingEvent[] @relation("TrackingEventActor")
  assignedPickups   PickupRequest[] @relation("PickupAssignee")
  assignedTickets   SupportTicket[] @relation("TicketAssignee")
}

model MerchantProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  companyName        String
  contactName        String
  phone              String
  pickupAddress      String
  city               String
  website            String?
  accountNature      String
  productType        String
  monthlyShipmentVolume String
  logoStorageKey     String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankDetail         MerchantBankDetail?
  shipments          Shipment[]
  pickupRequests     PickupRequest[]
  supportTickets     SupportTicket[]
  remittances        Remittance[]

  @@index([companyName])
  @@index([city])
}

model MerchantBankDetail {
  id              String   @id @default(cuid())
  merchantId      String   @unique
  bankName        String?
  accountTitle    String?
  encryptedAccountNumber String?
  branchName      String?
  branchCode      String?
  swiftCode       String?
  encryptedIban   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  merchant        MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipHash    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Shipment {
  id                 String         @id @default(cuid())
  merchantId         String
  trackingCode       String         @unique
  status             ShipmentStatus @default(CREATED)
  serviceName        String?
  recipientName      String
  recipientPhone     String
  deliveryAddress    String
  destinationCity    String
  itemDescription    String?
  pieces             Int            @default(1)
  codAmount          Decimal?       @db.Decimal(12, 2)
  collectedAmount    Decimal?       @db.Decimal(12, 2)
  publicSummary      String?
  internalNote       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  merchant           MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  events             TrackingEvent[]
  pickupRequest      PickupRequest?
  pickupShipments    PickupShipment[]
  remittanceId       String?
  remittance         Remittance?    @relation(fields: [remittanceId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt])
  @@index([status, updatedAt])
  @@index([remittanceId])
}

model TrackingEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  location    String?
  publicNote  String
  internalNote String?
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  actorId     String?
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actor       User?          @relation("TrackingEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([shipmentId, occurredAt])
}

model PickupRequest {
  id            String          @id @default(cuid())
  merchantId    String
  shipmentId    String?         @unique
  status        PickupStatus    @default(REQUESTED)
  pickupAddress String
  contactPerson String?
  contactPhone  String?
  timeWindow    String?
  requestedFor  DateTime?
  assignedToId  String?
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  merchant      MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  shipment      Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  assignedTo    User?           @relation("PickupAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  shipments     PickupShipment[]

  @@index([merchantId, status])
  @@index([assignedToId, status])
}

model PickupShipment {
  id              String        @id @default(cuid())
  pickupRequestId String
  shipmentId      String
  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  shipment        Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([pickupRequestId, shipmentId])
  @@index([shipmentId])
}

model Remittance {
  id              String           @id @default(cuid())
  merchantId      String
  reference       String           @unique
  status          RemittanceStatus @default(PENDING)
  amount          Decimal          @db.Decimal(12, 2)
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  payoutReference String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  merchant        MerchantProfile  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  shipments       Shipment[]

  @@index([merchantId, periodEnd])
}

model SupportTicket {
  id           String          @id @default(cuid())
  merchantId   String
  shipmentId   String?
  subject      String
  status       TicketStatus    @default(OPEN)
  priority     String          @default("NORMAL")
  assignedToId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  merchant     MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  assignedTo   User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([merchantId, status])
  @@index([assignedToId, status])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String?
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  summary    String
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
